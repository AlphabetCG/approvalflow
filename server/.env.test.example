# Copy to ".env.test" for running tests locally. Never commit the real file.
# The test setup wipes this database, so it must be on localhost and its name must
# be "test" or end with "_test". Change 5433 if you set DB_PORT (see README).
DATABASE_URL="postgresql://approvalflow:approvalflow@localhost:5433/approvalflow_test?schema=public"
NODE_ENV=test
