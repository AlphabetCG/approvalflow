# Copy to ".env" for local development. Never commit the real .env file.
# Values here are placeholders only.

# PostgreSQL connection string. Matches compose.dev.yml for local runs
# (change 5433 if you set DB_PORT, see README).
# In the cloud this comes from Secret Manager.
DATABASE_URL="postgresql://approvalflow:approvalflow@localhost:5433/approvalflow?schema=public"

# How long a login session lasts, in hours (F-01, D-06). Default 8.
# SESSION_TTL_HOURS=8

# Password for every demo user created by `npm run prisma:seed` (at least 8 characters).
# Without it the seed creates no users. Secret: share it privately, never commit it.
# In the cloud this comes from Secret Manager.
# DEMO_USER_PASSWORD=change-me-locally

# Port the server listens on. Cloud Run sets this itself.
PORT=3000

# Runtime mode: development | test | production
# NODE_ENV=development

# Allowed web origins, comma-separated (only needed when the client runs on another origin).
# CORS_ORIGIN=http://localhost:5173

# Where the built React app is, relative to the server folder (default ../client/dist).
# CLIENT_DIST=../client/dist
